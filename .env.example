# Copy this file to .env for local runs, or let docker-compose read it.

# LLM planner / memory summary. DeepSeek is OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional MiniMax tools.
MINIMAX_API_KEY=
MINIMAX_TTS_API_KEY=

# Local defaults when running outside Docker.
POSTGRES_URI=postgresql://agent:agent@localhost:5432/agent_runtime
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_runtime
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Used only when starting the worker service through docker-compose.
TASK_ID=

